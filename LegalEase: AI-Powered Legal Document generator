async function generateDoc() {
    const docType = document.getElementById('docType').value;
    const parties = document.getElementById('parties').value;
    const keyTerms = document.getElementById('keyTerms').value;

    const response = await fetch('/api/v1/documents/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ doc_type: docType, parties: parties, key_terms: keyTerms })
    });

    const data = await response.json();
    if (data.status === "success") {
        document.getElementById('docPreview').value = data.generated_doc;
    } else {
        alert("Generation failed!");
    }
}

async function downloadDoc(format) {
    const content = document.getElementById('docPreview').value;
    if (!content) return alert("No document generated to export.");

    const response = await fetch('/api/v1/documents/export', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: content, export_format: format })
    });

    const blob = await response.blob();
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `legal_document.${format}`;
    document.body.appendChild(a);
    a.click();
    a.remove();
}
