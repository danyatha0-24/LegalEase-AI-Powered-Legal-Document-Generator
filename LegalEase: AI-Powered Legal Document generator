import google.generativeai as genai
import os
from dotenv import load_dotenv

load_dotenv()

class AIService:
    def __init__(self):
        api_key = os.getenv("GEMINI_API_KEY", "YOUR_GEMINI_API_KEY")
        genai.configure(api_key=api_key)
        # Using Gemini model for legal document generation
        self.model = genai.GenerativeModel("gemini-pro")

    def generate_legal_content(self, doc_type: str, parties: str, key_terms: str) -> str:
        prompt = f"""
        You are an expert legal draft assistant. Generate a formal {doc_type} contract.
        
        Parties Involved:
        {parties}
        
        Key Terms & Clauses:
        {key_terms}
        
        Ensure professional language, clear section headings, standard legal boilerplate, 
        and structured formatting.
        """
        response = self.model.generate_content(prompt)
        return response.text

ai_service = AIService()
import io
from docx import Document
from fpdf import FPDF

class DocumentExporter:
    @staticmethod
    def to_txt(content: str) -> io.BytesIO:
        buffer = io.BytesIO()
        buffer.write(content.encode('utf-8'))
        buffer.seek(0)
        return buffer

    @staticmethod
    def to_docx(content: str) -> io.BytesIO:
        doc = Document()
        for line in content.split('\n'):
            if line.startswith('#'):
                doc.add_heading(line.lstrip('#').strip(), level=1)
            else:
                doc.add_paragraph(line)
        
        buffer = io.BytesIO()
        doc.save(buffer)
        buffer.seek(0)
        return buffer

    @staticmethod
    def to_pdf(content: str) -> io.BytesIO:
        pdf = FPDF()
        pdf.add_page()
        pdf.set_font("Helvetica", size=11)
        
        # Simple multi-line text write
        for line in content.split('\n'):
            # Encode/decode to maintain ASCII compatibility for standard FPDF fonts
            clean_line = line.encode('latin-1', 'replace').decode('latin-1')
            pdf.multi_cell(0, 10, txt=clean_line)
            
        buffer = io.BytesIO()
        pdf_output = pdf.output()
        buffer.write(pdf_output)
        buffer.seek(0)
        return buffer
from fastapi import APIRouter, HTTPException, Response
from pydantic import BaseModel
from services.ai_service import ai_service
from core.document_generator import DocumentExporter

router = APIRouter(prefix="/api/v1/documents", tags=["Documents"])

class DocumentRequest(BaseModel):
    doc_type: str  # e.g., "NDA", "Employment Contract", "Lease Agreement"
    parties: str   # e.g., "Company A and John Doe"
    key_terms: str # e.g., "Effective Date: Oct 1, 2026. Non-compete duration: 2 years."

class DownloadRequest(BaseModel):
    content: str
    export_format: str  # "pdf", "docx", "txt"

@router.post("/generate")
async def generate_document(payload: DocumentRequest):
    try:
        content = ai_service.generate_legal_content(
            doc_type=payload.doc_type,
            parties=payload.parties,
            key_terms=payload.key_terms
        )
        return {"status": "success", "generated_doc": content}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.post("/export")
async def export_document(payload: DownloadRequest):
    fmt = payload.export_format.lower()
    
    if fmt == "pdf":
        buffer = DocumentExporter.to_pdf(payload.content)
        media_type = "application/pdf"
        filename = "legal_document.pdf"
    elif fmt == "docx":
        buffer = DocumentExporter.to_docx(payload.content)
        media_type = "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        filename = "legal_document.docx"
    elif fmt == "txt":
        buffer = DocumentExporter.to_txt(payload.content)
        media_type = "text/plain"
        filename = "legal_document.txt"
    else:
        raise HTTPException(status_code=400, detail="Unsupported format")

    return Response(
        content=buffer.getvalue(),
        media_type=media_type,
        headers={"Content-Disposition": f"attachment; filename={filename}"}
    )
